{
  "name": "philosophia",
  "productName": "Philosophia",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first workspace for incremental reading and spaced repetition.",
  "author": "Philosophia contributors",
  "license": "MIT",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "npm start",
    "test": "node --import tsx --test tests/store.test.ts",
    "test:desktop": "node tests/desktop.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "org.philosophia.desktop",
    "productName": "Philosophia",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE"
    ],
    "npmRebuild": false,
    "mac": {
      "target": "dmg",
      "identity": "-",
      "category": "public.app-category.education",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "executableName": "philosophia",
      "syncDesktopName": true
    },
    "artifactName": "Philosophia-${version}-${os}-${arch}.${ext}",
    "toolsets": {
      "appimage": "1.0.3",
      "nsis": "1.2.1"
    }
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@mozilla/readability": "^0.6.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.468.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "^5.4.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "desktopName": "org.philosophia.desktop",
  "engines": {
    "node": ">=22.18.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}
